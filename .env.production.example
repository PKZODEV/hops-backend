# Production-environment template. DO NOT commit a populated copy of this
# file. Copy it to `.env.production` (untracked) on the deployment host or
# inject the variables through your secrets manager.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hops_db?schema=public&sslmode=require"
PORT=3001
NODE_ENV=production

# Generate with: openssl rand -base64 48
JWT_SECRET=""

ALLOWED_ORIGINS=https://admin.hopsthailand.com
