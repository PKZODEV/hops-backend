# ─── Required ───────────────────────────────────────────────────────────────

# PostgreSQL connection string consumed by Prisma. Must include `?schema=public`.
DATABASE_URL="postgresql://user:password@localhost:5432/hops_db?schema=public"

# Secret used to sign JWT access tokens. MUST be at least 32 characters long
# in production. The application refuses to start if this variable is unset
# or below the minimum length when NODE_ENV=production.
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars-long"

# ─── Server ─────────────────────────────────────────────────────────────────

# Port the HTTP server binds to. Defaults to 3001 when unset.
PORT=3001

# `development` | `staging` | `production`. Cookie `Secure` flag and the
# JWT-secret strength check are gated on this value.
NODE_ENV=development

# Comma-separated list of browser origins allowed by CORS. Mobile apps and
# server-to-server calls are unaffected by CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Public origin of the admin web app, used to build links inside outgoing
# password-reset emails. No trailing slash.
APP_URL=http://localhost:3000

# ─── SMTP (transactional email) ─────────────────────────────────────────────

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HOPS <no-reply@hopsthailand.com>"
