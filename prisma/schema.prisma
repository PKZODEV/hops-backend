generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// Enums
// --------------------------------------------------------

enum PropertyType {
  HOTEL
  RESORT
  GUESTHOUSE
  VILLA
  HOSTEL
  VEHICLE_RENTAL
  BUS_TRANSPORT
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
  MAINTENANCE
  DISABLED
}

enum AmenityType {
  HOTEL
  ROOM
}

enum VehicleType {
  CAR
  VAN
  MINIBUS
  BUS
  LOCAL
  MOTORCYCLE
  TUKTUK
  BOAT
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  BUSY
  MAINTENANCE
  DISABLED
}

enum VehicleOwnerType {
  HOTEL        // ยานพาหนะของที่พักในระบบ
  QUEUE_OWNER  // เจ้าของคิวรถ เช่น เจ๊อี๊ดคิวรถแดง คิวรถตู้
  INDEPENDENT  // รถอิสระ / รถส่วนตัวรับจ้าง
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  HOTEL_OWNER
  QUEUE_OWNER
  GUEST
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationRole {
  HOTEL_OWNER
  QUEUE_OWNER
}

enum BookingStatus {
  PENDING                     // รอชำระเงิน
  AWAITING_ROOM_ASSIGNMENT    // รอเจ้าหน้าที่ระบุห้องพัก (ใหม่)
  CONFIRMED                   // ยืนยันแล้ว / รอเช็คอิน
  CHECKED_IN                  // เช็คอินแล้ว / กำลังเข้าพัก
  CHECKOUT_PENDING            // รอ admin อนุมัติเช็คเอาท์ (ใหม่)
  AWAITING_EXTRA_PAYMENT      // รอลูกค้าชำระค่าใช้จ่ายเพิ่มเติม (ใหม่)
  CHECKED_OUT                 // เช็คเอาท์แล้ว / สำเร็จ
  CANCELLED                   // ยกเลิก
  REFUNDED                    // คืนเงินแล้ว
  NO_SHOW                     // ไม่มาเข้าพัก
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

// --------------------------------------------------------
// Models
// --------------------------------------------------------

/// สิ่งอำนวยความสะดวก (master data: Wi-Fi, สระว่ายน้ำ, อ่างอาบน้ำ ...)
model Amenity {
  id        String      @id @default(cuid())
  name      String
  icon      String?     // lucide-react icon name, e.g. "Wifi", "Waves"
  type      AmenityType
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([name, type])
  @@index([type])
}

/// ประเภทที่พัก (master data: โรงแรม, พูลวิลล่า, โฮมสเตย์ ...)
model PropertyCategory {
  id         String     @id @default(cuid())
  name       String     @unique
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  properties Property[]
}

/// ที่พัก (โรงแรม / รีสอร์ท / รถเช่า / รถโดยสาร ฯลฯ)
model Property {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id])
  propertyCategoryId String?
  propertyCategory   PropertyCategory? @relation(fields: [propertyCategoryId], references: [id])
  name               String
  type               PropertyType      @default(HOTEL)
  description        String?
  address            String?
  location           String?
  city               String?
  country            String            @default("Thailand")
  latitude           Float?
  longitude          Float?
  amenities          String[]          // e.g. ["wifi","parking","pool"]
  images             String[]          // array of image URLs
  isActive           Boolean           @default(true)
  /// % บวกราคาเพิ่มจากราคาที่เจ้าของโรงแรมตั้ง (ตั้งโดย admin) — 0..100
  markupPercentage   Float             @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  buildings Building[]
  roomTypes RoomType[]
  vehicles  Vehicle[]
  bookings  Booking[]
  reviews   Review[]

  @@index([userId])
  @@index([propertyCategoryId])
}

/// เจ้าของคิวรถ เช่น เจ๊อี๊ดคิวรถแดง คิวรถตู้ภูเก็ต สหกรณ์ฯลฯ
model VehicleOwner {
  id          String    @id @default(cuid())
  name        String    // ชื่อคิว เช่น "เจ๊อี๊ดคิวรถแดง"
  contactName String?   // ชื่อผู้ดูแล
  phone       String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vehicles Vehicle[]
  users    User[]
}

/// อาคาร (Building A, Building B ...)
model Building {
  id         String   @id @default(cuid())
  name       String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floors     Floor[]

  @@index([propertyId])
}

/// ชั้น (Floor 1, Floor 2 ...)
model Floor {
  id         String   @id @default(cuid())
  number     String   // "1", "2", "B1", "M"
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  roomUnits  RoomUnit[]

  @@index([buildingId])
}

/// ประเภทห้องพัก (Standard, Deluxe, Suite ...)
model RoomType {
  id          String   @id @default(cuid())
  name        String
  description String?
  bedType     String?
  maxGuests   Int
  images      String[]
  amenities   String[] // in-room amenities e.g. ["bathtub","wifi","tv"]
  isActive    Boolean  @default(true)
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomUnits RoomUnit[]
  rates     RoomRate[]
  bookings  Booking[]

  @@index([propertyId])
}

/// ห้องพักจริง (101, 102, 201A ...)
model RoomUnit {
  id         String     @id @default(cuid())
  number     String
  status     RoomStatus @default(AVAILABLE)
  amenities  String[]
  images     String[]
  floorId    String
  floor      Floor      @relation(fields: [floorId], references: [id])
  roomTypeId String
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id])

  bookings   Booking[]

  @@index([floorId])
  @@index([roomTypeId])
}

/// เรทราคาห้องพัก (Standard Rate / Weekend Rate / Early Bird ...)
model RoomRate {
  id         String    @id @default(cuid())
  name       String
  price      Decimal   @db.Decimal(10, 2)
  currency   String    @default("THB")
  startDate  DateTime?
  endDate    DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  roomTypeId String
  roomType   RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId])
}

/// ผู้ใช้ระบบ (Admin / Staff / เจ้าของที่พัก / เจ้าของคิวรถ)
model User {
  id                  String     @id @default(cuid())
  email               String
  name                String?
  phone               String?
  passwordHash        String
  role                UserRole   @default(HOTEL_OWNER)
  isActive            Boolean    @default(true)
  mustChangePassword  Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  properties     Property[]
  vehicleOwnerId String?
  vehicleOwner   VehicleOwner? @relation(fields: [vehicleOwnerId], references: [id])

  passwordResetTokens PasswordResetToken[]

  @@unique([email, role])
  @@index([vehicleOwnerId])
}

/// Token สำหรับ reset รหัสผ่าน (ลืมรหัสผ่าน)
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

/// คำขอลงทะเบียนเข้าใช้ระบบ (รออนุมัติโดย SUPER_ADMIN)
model RegistrationRequest {
  id            String                    @id @default(cuid())
  role          RegistrationRole
  name          String
  email         String
  phone         String
  businessName  String
  address       String?
  latitude      Float?
  longitude     Float?
  documents     Json                      // { type: url, ... }
  status        RegistrationRequestStatus @default(PENDING)
  rejectReason  String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  reviewedAt    DateTime?
  reviewedById  String?
  createdUserId String?

  @@index([status])
  @@index([email])
}

/// OTP สำหรับยืนยันตัวตน (สมัครสมาชิก, ลืมรหัสผ่าน)
model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String
  refCode   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([refCode])
}

/// ยานพาหนะและบริการรับส่ง (รถยนต์ รถตู้ รถแดง ตุ๊กตุ๊ก เรือ ...)
model Vehicle {
  id             String           @id @default(cuid())
  name           String           // "รถแดง เชียงใหม่", "Toyota Commuter"
  type           VehicleType
  ownerType      VehicleOwnerType @default(HOTEL)
  description    String?
  licensePlate   String?          // ทะเบียนรถ
  capacity       Int              @default(4)
  status         VehicleStatus    @default(AVAILABLE)
  images         String[]
  features       String[]         // AC, WiFi, ที่นั่งเด็ก ...
  pricePerTrip   Decimal?         @db.Decimal(10, 2)
  pricePerHour   Decimal?         @db.Decimal(10, 2)
  pricePerDay    Decimal?         @db.Decimal(10, 2)
  route          String?          // เส้นทาง เช่น "เชียงใหม่ - ดอยสุเทพ"
  driverName     String?
  driverPhone    String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  propertyId     String?
  property       Property?        @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  vehicleOwnerId String?
  vehicleOwner   VehicleOwner?    @relation(fields: [vehicleOwnerId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([vehicleOwnerId])
}

/// ค่าใช้จ่ายเพิ่มเติมตอนเช็คเอาท์ (เช่น มินิบาร์, ค่าซักรีด)
model BookingExtraCharge {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name      String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([bookingId])
}

/// รีวิวที่พัก (จาก guest หลังเช็คเอาท์)
model Review {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rating       Int      // 1-5
  comment      String?
  guestName    String
  createdAt    DateTime @default(now())

  @@index([propertyId])
  @@index([rating])
}

/// การจองห้องพัก (Booking) — สร้างจากแอปมือถือ, จัดการจาก admin panel
model Booking {
  id             String        @id @default(cuid())
  bookingCode    String        @unique // human-friendly code, e.g. HP-AB12CD

  /// ที่พัก (Property — denormalized for easy filtering)
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// ประเภทห้อง / Room type ที่จอง
  roomTypeId     String
  roomType       RoomType      @relation(fields: [roomTypeId], references: [id])

  /// ห้องจริงที่ assign (จะ assign ตอน check-in หรือก่อนหน้า)
  roomUnitId     String?
  roomUnit       RoomUnit?     @relation(fields: [roomUnitId], references: [id])

  /// ข้อมูลผู้เข้าพัก (จากฟอร์ม mobile)
  guestFirstName String
  guestLastName  String
  guestEmail     String
  guestPhone     String
  guestCount     Int           @default(2)
  specialRequest String?

  /// วันที่เข้าพัก
  checkInDate    DateTime      @db.Date
  checkOutDate   DateTime      @db.Date
  nights         Int

  /// ราคา (snapshot ของราคาตอนจอง)
  pricePerNight  Decimal       @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  currency       String        @default("THB")

  /// ผู้ให้บริการ (Hops, traveloka, agoda, ...) — store as plain string
  provider       String        @default("Hops")

  /// สถานะ
  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)

  /// เช็คอิน / เช็คเอาท์ จริง (ถ้าทำผ่าน admin)
  checkedInAt    DateTime?
  checkedOutAt   DateTime?

  /// ยกเลิก / คืนเงิน
  cancelledAt    DateTime?
  cancelReason   String?
  refundedAt     DateTime?
  refundAmount   Decimal?      @db.Decimal(10, 2)

  /// staff ที่ทำรายการ (ถ้าทำจาก admin)
  handledById    String?

  /// คำขอเช็คเอาท์ (ส่งจาก mobile)
  checkoutRequestedAt DateTime?

  /// ค่าใช้จ่ายเพิ่มเติมตอนเช็คเอาท์ (ถ้ามี)
  extraCharges        BookingExtraCharge[]
  extraChargesTotal   Decimal?  @db.Decimal(10, 2)
  extraChargesPaidAt  DateTime?

  review         Review?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([propertyId])
  @@index([roomTypeId])
  @@index([roomUnitId])
  @@index([status])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@index([guestEmail])
}
